{
  "name": "emc-iwisp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generador interno de estados de cuenta PDF a partir del portal I-WISP",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsx watch src/ui/server.ts",
    "start": "node dist/ui/server.js",
    "validar": "tsx scripts/validar.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "puppeteer": "^23.11.1",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
