# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio (ya está en .gitignore).

# API Key de la licencia de I-WISP (usa /api/*)
IWISP_API_KEY=

# Credenciales del portal web (usan /login -> /sesion)
IWISP_WISP_ID=
IWISP_USERNAME=
IWISP_PASSWORD=

# Base URL del portal (opcional)
IWISP_BASE_URL=https://cloud.iwisp.mx:4434

# Puerto del servidor UI (opcional, por defecto 3000)
# PORT=3000

# Nivel de log (opcional): debug | info | warn | error
# LOG_LEVEL=info
